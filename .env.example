# ─────────────────────────────────────────────────────────────────────────────
# Smart Chef HR — пример переменных окружения. Скопируй в .env и заполни.
#
# Railway:
#   • DATABASE_URL и REDIS_URL Railway проставит автоматически (PostgreSQL и Redis
#     плагины). Не задавай DB_URL — приложение само поймёт DATABASE_URL.
#   • Для Google Sheets используй GOOGLE_SA_JSON (вставь весь JSON service-account
#     одной строкой) или GOOGLE_SA_JSON_B64 (base64). GOOGLE_SA_JSON_PATH оставь пустым.
#   • Полный гайд — в README.md, секция «Railway».
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram ─────────────────────────────────────────────────────────────────
BOT_TOKEN=123456:replace-me
BOT_USERNAME=SmartChefHR_bot
ADMIN_IDS=[111111111,222222222]

# ── Database ─────────────────────────────────────────────────────────────────
# Локально / docker compose: явно задаём DB_URL.
# На Railway: оставь пустым — приложение подхватит DATABASE_URL из плагина PostgreSQL.
DB_URL=postgresql+asyncpg://smartchef:smartchef@postgres:5432/smartchef
DB_ECHO=false

# ── Redis (FSM storage + cache) ──────────────────────────────────────────────
# Railway: значение придёт из плагина Redis автоматически.
REDIS_URL=redis://redis:6379/0

# ── Google Sheets integration ────────────────────────────────────────────────
# Локально: путь до service-account JSON-ключа внутри контейнера.
# На Railway: оставь GOOGLE_SA_JSON_PATH пустым, задай GOOGLE_SA_JSON или
# GOOGLE_SA_JSON_B64 как env var (full JSON одной строкой / base64).
GOOGLE_SA_JSON_PATH=/run/secrets/google-sa.json
GOOGLE_SA_JSON=
GOOGLE_SA_JSON_B64=
GOOGLE_SHEET_ID=

# ── Payments ─────────────────────────────────────────────────────────────────
# manual | telegram | kaspi
PAYMENT_PROVIDER=manual
TELEGRAM_PAYMENT_TOKEN=
KASPI_API_KEY=
KASPI_MERCHANT_ID=
# Статическая ссылка/QR Kaspi для оплаты подписки (одна на все тарифы).
# Пользователь платит по ней, жмёт «Я оплатил», админ подтверждает.
KASPI_PAYMENT_URL=https://pay.kaspi.kz/pay/jxf26u54

# ── Tariffs (₸/месяц) — для прозрачности; реальные значения в core/constants ─
TARIFF_CANDIDATE=1000
TARIFF_EMPLOYER_BASIC=10000
TARIFF_EMPLOYER_EXTENDED=20000
EMPLOYER_BASIC_LIMIT=20
EMPLOYER_EXTENDED_LIMIT=50

# ── Referral ─────────────────────────────────────────────────────────────────
REFERRAL_BONUS=300                # обычный пользователь привёл друга
REFERRAL_BONUS_PROMOTER=1000      # промоутер (сотрудник) привёл друга
REFERRAL_MIN_WITHDRAWAL=1000
REFERRAL_WITHDRAWAL_DELAY_HOURS=24

# ── Google Gemini (генеративный AI) ──────────────────────────────────────────
# Ключ из Google AI Studio: https://aistudio.google.com/apikey
# Пусто → AI-функции выключены, бот работает на rule-based логике (без обращений к AI).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_ENABLED=true
GEMINI_TIMEOUT=12.0

# ── Misc ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=dev
LOG_LEVEL=INFO
TIMEZONE=Asia/Almaty
